{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "dest_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "timeout_ms": {
      "default": 120000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 600000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "source_path",
    "dest_path",
    "timeout_ms",
    "device_serial"
  ],
  "additionalProperties": false,
  "$id": "files-copy-request"
}
