{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "object",
      "properties": {
        "screen_brightness": {
          "type": "object",
          "properties": {
            "raw": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                {
                  "type": "null"
                }
              ]
            },
            "max": {
              "type": "number",
              "const": 255
            },
            "normalized": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "raw",
            "max",
            "normalized"
          ],
          "additionalProperties": false
        },
        "mode": {
          "type": "object",
          "properties": {
            "raw": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "type": "string",
              "enum": [
                "manual",
                "automatic",
                "unknown"
              ]
            }
          },
          "required": [
            "raw",
            "value"
          ],
          "additionalProperties": false
        },
        "auto_brightness_adjustment": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "screen_brightness_float": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "screen_brightness",
        "mode",
        "auto_brightness_adjustment",
        "screen_brightness_float"
      ],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "brightness": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sdr_brightness": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_brightness": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_adjusted_brightness": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "min": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "brightness",
        "sdr_brightness",
        "cached_brightness",
        "cached_adjusted_brightness",
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "settings_system_screen_brightness",
                  "settings_system_screen_brightness_mode",
                  "settings_system_screen_auto_brightness_adj",
                  "settings_system_screen_brightness_float",
                  "dumpsys_display"
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command_duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "method",
              "exit_code",
              "command_duration_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "display_brightness_state_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_display_brightness_state_not_visual_luminance"
    }
  },
  "required": [
    "device_serial",
    "settings",
    "display",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-brightness-get-result"
}
