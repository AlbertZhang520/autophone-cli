{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "from_selector": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "content_desc": {
          "type": "string",
          "minLength": 1
        },
        "class_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "to_selector": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "content_desc": {
          "type": "string",
          "minLength": 1
        },
        "class_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "from_candidate_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "to_candidate_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gesture": {
      "default": "draganddrop",
      "type": "string",
      "enum": [
        "draganddrop",
        "swipe"
      ]
    },
    "duration_ms": {
      "default": 1000,
      "type": "integer",
      "minimum": 100,
      "maximum": 10000
    },
    "verify": {
      "default": "none",
      "type": "string",
      "enum": [
        "screen_changed",
        "none"
      ]
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "from_selector",
    "to_selector",
    "gesture",
    "duration_ms",
    "verify",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "drag-request"
}
