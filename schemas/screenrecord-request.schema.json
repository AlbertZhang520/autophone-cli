{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "overwrite": {
      "default": false,
      "type": "boolean"
    },
    "duration_seconds": {
      "default": 5,
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "bit_rate_bps": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100000000
    },
    "size": {
      "type": "string",
      "pattern": "^[1-9]\\d{1,4}x[1-9]\\d{1,4}$"
    },
    "bugreport": {
      "default": false,
      "type": "boolean"
    },
    "record_timeout_ms": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 600000
    },
    "pull_timeout_ms": {
      "default": 120000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 600000
    },
    "cleanup_timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "output_path",
    "overwrite",
    "duration_seconds",
    "bugreport",
    "record_timeout_ms",
    "pull_timeout_ms",
    "cleanup_timeout_ms",
    "device_serial"
  ],
  "additionalProperties": false,
  "$id": "screenrecord-request"
}
