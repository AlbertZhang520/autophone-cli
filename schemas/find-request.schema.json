{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "selector": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "content_desc": {
          "type": "string",
          "minLength": 1
        },
        "class_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "selector",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "find-request"
}
