{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+(\\/[A-Za-z0-9_.$]+)?$"
    },
    "previous_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+(\\/[A-Za-z0-9_.$]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "switched",
        "already_current"
      ]
    },
    "enable": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "not_needed",
            "already_enabled",
            "enabled_now"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "exit_code": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "command_duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "exit_code",
                "command_duration_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action",
        "outcome"
      ],
      "additionalProperties": false
    },
    "set": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "command_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "exit_code",
            "command_duration_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "ime_state_readback"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "switches_user_visible_default_ime_reversible_via_previous_id"
    }
  },
  "required": [
    "device_serial",
    "requested_id",
    "previous_id",
    "status",
    "enable",
    "set",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-ime-set-result"
}
