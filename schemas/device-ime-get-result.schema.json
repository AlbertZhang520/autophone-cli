{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "keyboard": {
      "type": "object",
      "properties": {
        "shown": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "show_requested": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "fullscreen_mode": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shown",
        "show_requested",
        "fullscreen_mode"
      ],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "system_ready": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "interactive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "system_ready",
        "interactive"
      ],
      "additionalProperties": false
    },
    "ime": {
      "type": "object",
      "properties": {
        "current_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+(\\/[A-Za-z0-9_.$]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "default_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+(\\/[A-Za-z0-9_.$]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+(\\/[A-Za-z0-9_.$]+)?$"
          }
        },
        "enabled_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "current_id",
        "default_id",
        "enabled_ids",
        "enabled_count"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "dumpsys_input_method",
                  "settings_secure_default_input_method",
                  "settings_secure_enabled_input_methods"
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command_duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "method",
              "exit_code",
              "command_duration_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "input_method_service_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_ime_state_not_keyboard_geometry"
    }
  },
  "required": [
    "device_serial",
    "keyboard",
    "service",
    "ime",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-ime-get-result"
}
