{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "flags_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]+$"
          },
          "running": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "flags_hex",
          "running"
        ],
        "additionalProperties": false
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "running_user_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      }
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "pm_list_users"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "pm_list_users_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "standard_pm_list_users_non_verbose"
    }
  },
  "required": [
    "device_serial",
    "users",
    "count",
    "running_user_ids",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-users-result"
}
