{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
        }
      },
      "required": [
        "package_name"
      ],
      "additionalProperties": false
    },
    "installed": {
      "type": "boolean"
    },
    "package": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "package_name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
            },
            "app_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "code_path": {
              "type": "string",
              "minLength": 1
            },
            "resource_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "native_library_dir": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "primary_cpu_abi": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "secondary_cpu_abi": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "cpu_abi_override": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "min_sdk": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "target_sdk": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "code",
                "min_sdk",
                "target_sdk",
                "name"
              ],
              "additionalProperties": false
            },
            "splits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "private_flags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "timestamps": {
              "type": "object",
              "properties": {
                "time_stamp": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "last_update_time": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "time_stamp",
                "last_update_time"
              ],
              "additionalProperties": false
            },
            "installer": {
              "type": "object",
              "properties": {
                "package_name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "uid": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "initiating_package_name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "originating_package_name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "package_name",
                "uid",
                "initiating_package_name",
                "originating_package_name"
              ],
              "additionalProperties": false
            },
            "package_source": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "install_permissions_fixed": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "apex_module_name": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "package_name",
            "app_id",
            "code_path",
            "resource_path",
            "native_library_dir",
            "primary_cpu_abi",
            "secondary_cpu_abi",
            "cpu_abi_override",
            "version",
            "splits",
            "flags",
            "private_flags",
            "timestamps",
            "installer",
            "package_source",
            "install_permissions_fixed",
            "apex_module_name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "dumpsys_package"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "dumpsys_active_package_block"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "package_dump_active_block_not_hidden_not_permissions_not_signatures"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "installed",
    "package",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "app-package-info-result"
}
