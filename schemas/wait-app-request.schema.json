{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wait_timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "interval_ms": {
      "default": 500,
      "type": "integer",
      "minimum": 50,
      "maximum": 10000
    },
    "poll_timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "package_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "activity": {
      "type": "string",
      "pattern": "^(\\.[A-Za-z_$][A-Za-z0-9_.$]*|[A-Za-z_$][A-Za-z0-9_.$]*)$"
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "wait_timeout_ms",
    "interval_ms",
    "poll_timeout_ms",
    "package_name"
  ],
  "additionalProperties": false,
  "$id": "wait-app-request"
}
