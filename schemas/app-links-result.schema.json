{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
        }
      },
      "required": [
        "package_name"
      ],
      "additionalProperties": false
    },
    "package_found": {
      "type": "boolean"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?:\\*\\.)?[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*$"
          },
          "state": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "known",
                  "custom_error",
                  "unknown"
                ]
              },
              "code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "raw",
              "kind",
              "code"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "domain",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "domain_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "cmd_package_get_app_links"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "cmd_package_get_app_links_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_global_domain_verification_state_not_url_resolution_or_per_user_selection_or_signatures"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "package_found",
    "domains",
    "domain_count",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "app-links-result"
}
