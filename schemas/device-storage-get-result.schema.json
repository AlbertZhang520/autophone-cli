{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "data",
                  "shared",
                  "tmp"
                ]
              },
              "path": {
                "type": "string",
                "enum": [
                  "/data",
                  "/sdcard",
                  "/data/local/tmp"
                ]
              },
              "ok": {
                "type": "boolean",
                "const": true
              },
              "filesystem_type": {
                "type": "string",
                "minLength": 1
              },
              "block_size_bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "total_blocks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "available_blocks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "free_blocks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "total_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "available_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "free_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "used_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "role",
              "path",
              "ok",
              "filesystem_type",
              "block_size_bytes",
              "total_blocks",
              "available_blocks",
              "free_blocks",
              "total_bytes",
              "available_bytes",
              "free_bytes",
              "used_bytes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "data",
                  "shared",
                  "tmp"
                ]
              },
              "path": {
                "type": "string",
                "enum": [
                  "/data",
                  "/sdcard",
                  "/data/local/tmp"
                ]
              },
              "ok": {
                "type": "boolean",
                "const": false
              },
              "error": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": [
                      "statfs_failed",
                      "not_reported"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "reason",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "role",
              "path",
              "ok",
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ok_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unavailable_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "statfs_paths"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "/data",
              "/sdcard",
              "/data/local/tmp"
            ]
          }
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "paths",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "statfs_storage_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_storage_capacity_snapshot_not_quota_or_write_permission"
    }
  },
  "required": [
    "device_serial",
    "entries",
    "entry_count",
    "ok_count",
    "unavailable_count",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-storage-get-result"
}
