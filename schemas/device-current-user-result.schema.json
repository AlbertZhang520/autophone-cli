{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "current_user_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "cmd_activity_get_current_user"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "activity_manager_current_user"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "activity_manager_reported_current_user_id"
    }
  },
  "required": [
    "device_serial",
    "current_user_id",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-current-user-result"
}
