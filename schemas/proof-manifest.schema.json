{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proof_version": {
      "type": "string",
      "const": "0.3"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "device_serial": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "result_summary": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "error_summary": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace_summary": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "mime_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "path",
          "bytes",
          "sha256",
          "mime_type"
        ],
        "additionalProperties": false
      }
    },
    "redacted": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "proof_version",
    "command",
    "request_id",
    "runtime_version",
    "schema_version",
    "ok",
    "duration_ms",
    "device_serial",
    "result_summary",
    "error_summary",
    "warnings",
    "trace_summary",
    "artifacts",
    "redacted"
  ],
  "additionalProperties": false,
  "$id": "proof-manifest"
}
