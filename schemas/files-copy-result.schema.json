{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "dest_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "source_path",
        "dest_path"
      ],
      "additionalProperties": false
    },
    "before_source": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "entry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "regular_file",
                    "directory",
                    "symlink",
                    "other"
                  ]
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modified_unix_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "bytes",
                "modified_unix_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exists",
        "entry"
      ],
      "additionalProperties": false
    },
    "before_dest": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "entry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "regular_file",
                    "directory",
                    "symlink",
                    "other"
                  ]
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modified_unix_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "bytes",
                "modified_unix_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exists",
        "entry"
      ],
      "additionalProperties": false
    },
    "copy": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "device_cp_no_clobber"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "after_source": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "entry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "regular_file",
                    "directory",
                    "symlink",
                    "other"
                  ]
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modified_unix_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "bytes",
                "modified_unix_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exists",
        "entry"
      ],
      "additionalProperties": false
    },
    "after_dest": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "entry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "regular_file",
                    "directory",
                    "symlink",
                    "other"
                  ]
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modified_unix_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "bytes",
                "modified_unix_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exists",
        "entry"
      ],
      "additionalProperties": false
    },
    "copied": {
      "type": "boolean",
      "const": true
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "source_preserved_dest_present_after_copy"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 4
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "single_regular_file_non_clobber_copy"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "before_source",
    "before_dest",
    "copy",
    "after_source",
    "after_dest",
    "copied",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "files-copy-result"
}
