{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "local": {
          "type": "object",
          "properties": {
            "file_name": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "file_name",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "remote_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "compression": {
          "type": "string",
          "enum": [
            "adb_default",
            "any",
            "none",
            "brotli",
            "lz4",
            "zstd",
            "disabled"
          ]
        }
      },
      "required": [
        "local",
        "remote_path",
        "compression"
      ],
      "additionalProperties": false
    },
    "transfer": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "adb_push"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "adb_exit_success"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "device_serial",
    "requested",
    "transfer",
    "verify"
  ],
  "additionalProperties": false,
  "$id": "files-push-result"
}
