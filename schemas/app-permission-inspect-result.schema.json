{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "permission_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "package_name",
        "permission_name",
        "user_id"
      ],
      "additionalProperties": false
    },
    "package_found": {
      "type": "boolean"
    },
    "package": {
      "type": "object",
      "properties": {
        "target_sdk": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target_sdk"
      ],
      "additionalProperties": false
    },
    "permission": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "granted",
            "denied",
            "not_requested",
            "unknown"
          ]
        },
        "granted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "runtime",
            "install",
            "manifest_initial",
            "not_requested",
            "package_absent",
            "unresolved_user",
            "unknown"
          ]
        },
        "manifest_requested": {
          "type": "boolean"
        },
        "available_user_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "install": {
          "type": "object",
          "properties": {
            "present": {
              "type": "boolean"
            },
            "granted": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "present",
            "granted",
            "flags"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "present": {
              "type": "boolean"
            },
            "granted": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "selected_user_id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "user_present": {
              "type": "boolean"
            }
          },
          "required": [
            "present",
            "granted",
            "flags",
            "selected_user_id",
            "user_present"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "state",
        "granted",
        "source",
        "manifest_requested",
        "available_user_ids",
        "install",
        "runtime"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "dumpsys_package"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "dumpsys_permission_state"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "package_dump_permission_state_not_appops"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "package_found",
    "package",
    "permission",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "app-permission-inspect-result"
}
