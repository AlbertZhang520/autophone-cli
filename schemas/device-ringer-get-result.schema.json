{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "ringer": {
      "type": "object",
      "properties": {
        "internal": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "silent",
                "vibrate",
                "normal",
                "unknown"
              ]
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Z0-9_]+$"
            }
          },
          "required": [
            "mode",
            "raw"
          ],
          "additionalProperties": false
        },
        "external": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "silent",
                "vibrate",
                "normal",
                "unknown"
              ]
            },
            "raw": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Z0-9_]+$"
            }
          },
          "required": [
            "mode",
            "raw"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "internal",
        "external"
      ],
      "additionalProperties": false
    },
    "zen": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "important_interruptions",
            "no_interruptions",
            "alarms",
            "unknown"
          ]
        },
        "raw": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "dumpsys_audio_ringer_section",
            "not_reported"
          ]
        }
      },
      "required": [
        "mode",
        "raw",
        "source"
      ],
      "additionalProperties": false
    },
    "affected_streams": {
      "type": "object",
      "properties": {
        "mask_hex": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^STREAM_[A-Z0-9_]+$"
          }
        },
        "residual_tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[0-9]+$"
          }
        }
      },
      "required": [
        "mask_hex",
        "streams",
        "residual_tokens"
      ],
      "additionalProperties": false
    },
    "muted_streams": {
      "type": "object",
      "properties": {
        "mask_hex": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^STREAM_[A-Z0-9_]+$"
          }
        },
        "residual_tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[0-9]+$"
          }
        }
      },
      "required": [
        "mask_hex",
        "streams",
        "residual_tokens"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "dumpsys_audio"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "dumpsys_audio_ringer_state_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "audio_service_ringer_zen_state_not_effective_audibility"
    }
  },
  "required": [
    "device_serial",
    "ringer",
    "zen",
    "affected_streams",
    "muted_streams",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-ringer-get-result"
}
