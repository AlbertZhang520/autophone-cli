{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "object",
      "properties": {
        "airplane_mode_on": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "wifi_on": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "mobile_data_on": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "airplane_mode_on",
        "wifi_on",
        "mobile_data_on"
      ],
      "additionalProperties": false
    },
    "active": {
      "type": "object",
      "properties": {
        "network_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "wifi",
              "cellular",
              "ethernet",
              "vpn",
              "bluetooth",
              "other"
            ]
          }
        },
        "primary_transport": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "wifi",
                "cellular",
                "ethernet",
                "vpn",
                "bluetooth",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "internet_capable": {
          "type": "boolean"
        },
        "validated": {
          "type": "boolean"
        },
        "online": {
          "type": "boolean"
        }
      },
      "required": [
        "network_id",
        "transports",
        "primary_transport",
        "internet_capable",
        "validated",
        "online"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "settings_global_airplane_mode_on",
                  "settings_global_wifi_on",
                  "settings_global_mobile_data",
                  "dumpsys_connectivity"
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command_duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "method",
              "exit_code",
              "command_duration_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "settings_and_connectivity_service_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_connectivity_state_not_remote_reachability"
    }
  },
  "required": [
    "device_serial",
    "settings",
    "active",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-network-get-result"
}
