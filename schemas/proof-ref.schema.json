{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundle_dir": {
      "type": "string",
      "minLength": 1
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "redacted": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "bundle_dir",
    "manifest_path",
    "manifest_sha256",
    "total_bytes",
    "artifact_count",
    "redacted"
  ],
  "additionalProperties": false,
  "$id": "proof-ref"
}
