{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        }
      },
      "required": [
        "package_name"
      ],
      "additionalProperties": false
    },
    "running": {
      "type": "boolean"
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "process_name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "pid",
          "process_name"
        ],
        "additionalProperties": false
      }
    },
    "process_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "memory": {
      "type": "object",
      "properties": {
        "units": {
          "type": "string",
          "const": "kb"
        },
        "totals": {
          "type": "object",
          "properties": {
            "total_pss_kb": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_rss_kb": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_swap_pss_kb": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "total_pss_kb",
            "total_rss_kb",
            "total_swap_pss_kb"
          ],
          "additionalProperties": false
        },
        "app_summary": {
          "type": "object",
          "properties": {
            "java_heap": {
              "type": "object",
              "properties": {
                "pss_kb": {
                  "anyOf": [
