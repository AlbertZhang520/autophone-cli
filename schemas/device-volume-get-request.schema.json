{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stream": {
      "default": "music",
      "type": "string",
      "enum": [
        "voice_call",
        "system",
        "ring",
        "music",
        "alarm",
        "notification"
      ]
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "stream",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "device-volume-get-request"
}
