{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "runtime_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "object",
      "properties": {
        "serial": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "device_serial": {
              "type": "string",
              "minLength": 1
            },
            "requested": {
              "type": "object",
              "properties": {
                "package_name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
                }
              },
              "required": [
                "package_name"
              ],
              "additionalProperties": false
            },
            "running": {
              "type": "boolean"
            },
            "processes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pid": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "process_name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "pid",
                  "process_name"
                ],
                "additionalProperties": false
              }
            },
            "process_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "graphics": {
              "type": "object",
              "properties": {
                "stats_since_ns": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9]\\d*)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "total_frames_rendered": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "janky_frames": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "percent": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "count",
                        "percent"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "janky_frames_legacy": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "percent": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "count",
                        "percent"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "percentiles_ms": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "p50_ms": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "p90_ms": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "p95_ms": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "p99_ms": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "p50_ms",
                        "p90_ms",
                        "p95_ms",
                        "p99_ms"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "slow_counts": {
                  "type": "object",
                  "properties": {
                    "missed_vsync": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "high_input_latency": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "slow_ui_thread": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "slow_bitmap_uploads": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "slow_issue_draw_commands": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "missed_vsync",
                    "high_input_latency",
                    "slow_ui_thread",
                    "slow_bitmap_uploads",
                    "slow_issue_draw_commands"
                  ],
                  "additionalProperties": false
                },
                "frame_deadline_missed": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "frame_deadline_missed_legacy": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "histogram": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "buckets": {
                          "maxItems": 256,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "bucket_ms": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "count": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "bucket_ms",
                              "count"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "bucket_count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "truncated": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "buckets",
                        "bucket_count",
                        "truncated"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "gpu": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "percentiles_ms": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "p50_ms": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "p90_ms": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "p95_ms": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "p99_ms": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "p50_ms",
                                "p90_ms",
                                "p95_ms",
                                "p99_ms"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "histogram": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "buckets": {
                                  "maxItems": 256,
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "bucket_ms": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                      },
                                      "count": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                      }
                                    },
                                    "required": [
                                      "bucket_ms",
                                      "count"
                                    ],
                                    "additionalProperties": false
                                  }
                                },
                                "bucket_count": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "truncated": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "buckets",
                                "bucket_count",
                                "truncated"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "percentiles_ms",
                        "histogram"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "stats_since_ns",
                "total_frames_rendered",
                "janky_frames",
                "janky_frames_legacy",
                "percentiles_ms",
                "slow_counts",
                "frame_deadline_missed",
                "frame_deadline_missed_legacy",
                "histogram",
                "gpu"
              ],
              "additionalProperties": false
            },
            "query": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "const": "dumpsys_gfxinfo"
                },
                "exit_code": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "command_duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "method",
                "exit_code",
                "command_duration_ms"
              ],
              "additionalProperties": false
            },
            "verify": {
              "type": "object",
              "properties": {
                "policy": {
                  "type": "string",
                  "const": "dumpsys_gfxinfo_frame_summary_snapshot"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "attempts": {
                  "type": "number",
                  "const": 1
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "policy",
                "ok",
                "attempts",
                "reason"
              ],
              "additionalProperties": false
            },
            "semantics": {
              "type": "string",
              "const": "read_only_graphics_summary_since_last_reset_not_sustained_performance_guarantee"
            }
          },
          "required": [
            "device_serial",
            "requested",
            "running",
            "processes",
            "process_count",
            "graphics",
            "query",
            "verify",
            "semantics"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "NO_DEVICE",
                "MULTIPLE_DEVICES",
                "DEVICE_OFFLINE",
                "DEVICE_UNAUTHORIZED",
                "DEVICE_NOT_READY",
                "SCREEN_LOCKED",
                "DEVICE_SCREEN_FAILED",
                "DEVICE_NETWORK_FAILED",
                "DEVICE_STORAGE_FAILED",
                "DEVICE_LOCALE_FAILED",
                "DEVICE_BATTERY_FAILED",
                "DEVICE_TIME_FAILED",
                "DEVICE_IME_FAILED",
                "DEVICE_BRIGHTNESS_FAILED",
                "DEVICE_ANIMATIONS_FAILED",
                "DEVICE_ANIMATIONS_SET_FAILED",
                "DEVICE_ACCESSIBILITY_FAILED",
                "DEVICE_ORIENTATION_FAILED",
                "DEVICE_ORIENTATION_SET_FAILED",
                "DEVICE_STATUSBAR_FAILED",
                "DEVICE_VOLUME_FAILED",
                "DEVICE_RINGER_FAILED",
                "DEVICE_NOTIFICATIONS_FAILED",
                "DEVICE_CURRENT_USER_FAILED",
                "DEVICE_USERS_FAILED",
                "DRIVER_UNAVAILABLE",
                "UI_DUMP_FAILED",
                "DUMP_TIMEOUT",
                "TARGET_NOT_FOUND",
                "AMBIGUOUS_TARGET",
                "STALE_SNAPSHOT",
                "UNSAFE_OPERATION",
                "TEXT_ENCODING_UNSUPPORTED",
                "WINDOW_SIZE_UNAVAILABLE",
                "SCROLL_REGION_TOO_SMALL",
                "ACTIVITY_RESOLVE_FAILED",
                "APP_ACTIVITIES_FAILED",
                "APP_LIST_FAILED",
                "APP_CLEAR_DATA_FAILED",
                "APP_INSPECT_FAILED",
                "APP_INSTALL_FAILED",
                "APP_LAUNCH_FAILED",
                "APP_LINKS_FAILED",
                "APP_GRAPHICS_FAILED",
                "APP_MEMORY_FAILED",
                "APP_NOT_RUNNING",
                "APP_PACKAGE_INFO_FAILED",
                "APP_PIDS_FAILED",
                "APP_OPS_FAILED",
                "APP_OPEN_URL_FAILED",
                "APP_RESOLVE_URL_FAILED",
                "APP_PERMISSION_FAILED",
                "APP_PERMISSION_INSPECT_FAILED",
                "APP_STOP_FAILED",
                "APP_UNINSTALL_FAILED",
                "CLIPBOARD_GET_FAILED",
                "CLIPBOARD_SET_FAILED",
                "CLIPBOARD_UNSUPPORTED",
                "FILE_PUSH_FAILED",
                "FILE_PULL_FAILED",
                "FILE_STAT_FAILED",
                "FILE_HASH_FAILED",
                "FILE_RM_FAILED",
                "FILE_LIST_FAILED",
                "FILE_MKDIR_FAILED",
                "FILE_MOVE_FAILED",
                "FILE_COPY_FAILED",
                "ACTION_TIMEOUT",
                "LOGS_UNAVAILABLE",
                "VERIFY_FAILED",
                "WAIT_TIMEOUT",
                "PROOF_DIR_INVALID",
                "PROOF_WRITE_FAILED",
                "RECIPE_INVALID",
                "RECIPE_STEP_FAILED",
                "RECIPE_ABORTED",
                "RECIPE_PREDICATE_FAILED",
                "SCREENSHOT_INVALID",
                "SCREENRECORD_FAILED",
                "OUTPUT_EXISTS",
                "OUTPUT_WRITE_FAILED",
                "ADB_ERROR",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string"
            },
            "retriable": {
              "default": false,
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "retriable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema_version",
    "runtime_version",
    "request_id",
    "ok",
    "command",
    "duration_ms",
    "result",
    "error",
    "warnings",
    "trace"
  ],
  "additionalProperties": false,
  "$id": "app-graphics-response"
}
