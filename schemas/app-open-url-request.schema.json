{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "verify": {
      "default": "activity_manager_accepted",
      "type": "string",
      "enum": [
        "activity_manager_accepted",
        "none"
      ]
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "url",
    "verify",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "app-open-url-request"
}
