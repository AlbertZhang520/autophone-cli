{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
        },
        "intent": {
          "type": "string",
          "enum": [
            "launcher"
          ]
        }
      },
      "required": [
        "package_name",
        "intent"
      ],
      "additionalProperties": false
    },
    "found": {
      "type": "boolean"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "package_name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
          },
          "activity": {
            "type": "string",
            "minLength": 1
          },
          "relative_activity": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "component",
          "package_name",
          "activity",
          "relative_activity"
        ],
        "additionalProperties": false
      }
    },
    "activity_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "cmd_package_query_activities"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "cmd_package_query_activities_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_intent_activity_query_not_install_or_launchability_proof"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "found",
    "activities",
    "activity_count",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "app-activities-result"
}
