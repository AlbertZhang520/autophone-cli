{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "runtime_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "object",
      "properties": {
        "serial": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "device_serial": {
              "type": "string",
              "minLength": 1
            },
            "locales": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "tag": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "base_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  "script": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "region": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "tag",
                  "base_name",
                  "language",
                  "script",
                  "region"
                ],
                "additionalProperties": false
              }
            },
            "locales_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "primary_locale": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "tag": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "base_name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "language": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16
                    },
                    "script": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "region": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "tag",
                    "base_name",
                    "language",
                    "script",
                    "region"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "selected_source": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "system_locales",
                    "persist_sys_locale",
                    "ro_product_locale",
                    "ro_product_locale_language_region"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "sources": {
              "type": "object",
              "properties": {
                "system_locales": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "persist_sys_locale": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ro_product_locale": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ro_product_locale_language": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ro_product_locale_region": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "system_locales",
                "persist_sys_locale",
                "ro_product_locale",
                "ro_product_locale_language",
                "ro_product_locale_region"
              ],
              "additionalProperties": false
            },
            "invalid_sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "system_locales",
                      "persist_sys_locale",
                      "ro_product_locale",
                      "ro_product_locale_language_region"
                    ]
                  },
                  "index": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "source",
                  "index",
                  "value",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "query": {
              "type": "object",
              "properties": {
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string",
                        "enum": [
                          "settings_system_system_locales",
                          "getprop_persist_sys_locale",
                          "getprop_ro_product_locale",
                          "getprop_ro_product_locale_language",
                          "getprop_ro_product_locale_region"
                        ]
                      },
                      "exit_code": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "command_duration_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "method",
                      "exit_code",
                      "command_duration_ms"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "sources"
              ],
              "additionalProperties": false
            },
            "verify": {
              "type": "object",
              "properties": {
                "policy": {
                  "type": "string",
                  "const": "locale_sources_parse"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "attempts": {
                  "type": "number",
                  "const": 1
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "policy",
                "ok",
                "attempts",
                "reason"
              ],
              "additionalProperties": false
            },
            "semantics": {
              "type": "string",
              "const": "read_only_locale_state_not_app_language_or_translation"
            }
          },
          "required": [
            "device_serial",
            "locales",
            "locales_count",
            "primary_locale",
            "selected_source",
            "sources",
            "invalid_sources",
            "query",
            "verify",
            "semantics"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
