{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "default": "",
      "type": "string"
    },
    "activity": {
      "default": "",
      "type": "string"
    },
    "window_size": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "orientation": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "portrait",
        "landscape",
        "unknown"
      ]
    },
    "rotation_degrees": {
      "default": null,
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 90
            },
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 270
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "auto_rotate": {
      "default": null,
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "ui_hash": {
      "type": "string",
      "minLength": 1
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "default": "",
            "type": "string"
          },
          "resource_id": {
            "default": "",
            "type": "string"
          },
          "content_desc": {
            "default": "",
            "type": "string"
          },
          "class_name": {
            "default": "",
            "type": "string"
          },
          "package_name": {
            "default": "",
            "type": "string"
          },
          "bounds": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                ],
                "description": "[left, top, right, bottom] in device pixels"
              },
              {
                "type": "null"
              }
            ]
          },
          "enabled": {
            "default": null,
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "clickable": {
            "default": null,
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "focused": {
            "default": null,
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_index",
          "text",
          "resource_id",
          "content_desc",
          "class_name",
          "package_name",
          "bounds",
          "enabled",
          "clickable",
          "focused"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "snapshot_id",
    "created_at",
    "device_serial",
    "package",
    "activity",
    "window_size",
    "orientation",
    "rotation_degrees",
    "auto_rotate",
    "ui_hash",
    "elements"
  ],
  "additionalProperties": false,
  "$id": "snapshot"
}
