{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "max_chars": {
      "default": 64,
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "verify": {
      "default": "none",
      "type": "string",
      "enum": [
        "field_text",
        "screen_changed",
        "none"
      ]
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "max_chars",
    "verify",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "text-clear-request"
}
