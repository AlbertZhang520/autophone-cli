{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requested": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        }
      },
      "required": [
        "package_name"
      ],
      "additionalProperties": false
    },
    "before": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string"
        },
        "activity": {
          "type": "string"
        },
        "focused": {
          "type": "boolean"
        }
      },
      "required": [
        "device_serial",
        "package",
        "activity",
        "focused"
      ],
      "additionalProperties": false
    },
    "after": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "device_serial": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string"
            },
            "activity": {
              "type": "string"
            },
            "focused": {
              "type": "boolean"
            }
          },
          "required": [
            "device_serial",
            "package",
            "activity",
            "focused"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "stop": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "am_force_stop"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "foreground_absent",
            "none"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requested",
    "before",
    "after",
    "stop",
    "verify"
  ],
  "additionalProperties": false,
  "$id": "app-stop-result"
}
