{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "time": {
      "type": "object",
      "properties": {
        "unix_epoch_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timezone_offset": {
          "type": "string",
          "pattern": "^[+-]\\d{2}:\\d{2}$"
        },
        "timezone_offset_minutes": {
          "type": "integer",
          "minimum": -1439,
          "maximum": 1439
        }
      },
      "required": [
        "unix_epoch_seconds",
        "timezone_offset",
        "timezone_offset_minutes"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "auto_time": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "auto_time_zone": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "auto_time",
        "auto_time_zone"
      ],
      "additionalProperties": false
    },
    "timezone": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "settings_global_time_zone",
                "persist_sys_timezone"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "object",
          "properties": {
            "settings_global_time_zone": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "persist_sys_timezone": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "settings_global_time_zone",
            "persist_sys_timezone"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "source",
        "sources"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "date_unix_epoch_offset",
                  "settings_global_auto_time",
                  "settings_global_auto_time_zone",
                  "settings_global_time_zone",
                  "getprop_persist_sys_timezone"
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command_duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "method",
              "exit_code",
              "command_duration_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "device_time_sources_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_device_time_snapshot_not_ntp_or_scheduler_guarantee"
    }
  },
  "required": [
    "device_serial",
    "time",
    "settings",
    "timezone",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-time-get-result"
}
