{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "android": {
      "type": "object",
      "properties": {
        "release": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sdk": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "codename": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "release",
        "sdk",
        "codename"
      ],
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "properties": {
        "manufacturer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "brand": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "product": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "supported_abis": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "manufacturer",
        "brand",
        "model",
        "product",
        "device",
        "supported_abis"
      ],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "physical_size": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "override_size": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "physical_density": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "override_density": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "physical_size",
        "override_size",
        "physical_density",
        "override_density"
      ],
      "additionalProperties": false
    },
    "battery": {
      "type": "object",
      "properties": {
        "level_percent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "unknown",
                "charging",
                "discharging",
                "not_charging",
                "full"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "plugged": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ac",
                "usb",
                "wireless",
                "dock",
                "none"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "temperature_celsius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level_percent",
        "scale",
        "status",
        "plugged",
        "temperature_celsius"
      ],
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "device_serial",
    "android",
    "hardware",
    "display",
    "battery",
    "properties"
  ],
  "additionalProperties": false,
  "$id": "device-info-result"
}
