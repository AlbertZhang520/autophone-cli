{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "selector": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "content_desc": {
          "type": "string",
          "minLength": 1
        },
        "class_name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "raw_point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "description": "[x, y] in device pixels"
    },
    "candidate_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allow_unsafe_raw_point": {
      "default": false,
      "type": "boolean"
    },
    "duration_ms": {
      "default": 800,
      "type": "integer",
      "minimum": 500,
      "maximum": 5000
    },
    "verify": {
      "default": "screen_changed",
      "type": "string",
      "enum": [
        "screen_changed",
        "none"
      ]
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "allow_unsafe_raw_point",
    "duration_ms",
    "verify",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "long-press-request"
}
