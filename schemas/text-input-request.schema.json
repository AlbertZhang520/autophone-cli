            "none"
          ]
        },
        "timeout_ms": {
          "default": 10000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "device_serial": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text",
        "via",
        "verify",
        "timeout_ms"
      ],
      "additionalProperties": false
    },
