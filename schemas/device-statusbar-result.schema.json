{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": [
        "expand_notifications",
        "expand_settings",
        "collapse"
      ]
    },
    "statusbar": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "cmd_statusbar"
        },
        "command": {
          "type": "string",
          "enum": [
            "expand-notifications",
            "expand-settings",
            "collapse"
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "command",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "cmd_statusbar_clean_exit"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "systemui_statusbar_panel_command"
    }
  },
  "required": [
    "device_serial",
    "action",
    "statusbar",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-statusbar-result"
}
