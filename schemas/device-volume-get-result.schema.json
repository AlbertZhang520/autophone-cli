{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "voice_call",
            "system",
            "ring",
            "music",
            "alarm",
            "notification"
          ]
        },
        "android_stream_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "android_stream_name": {
          "type": "string",
          "enum": [
            "STREAM_VOICE_CALL",
            "STREAM_SYSTEM",
            "STREAM_RING",
            "STREAM_MUSIC",
            "STREAM_ALARM",
            "STREAM_NOTIFICATION"
          ]
        }
      },
      "required": [
        "name",
        "android_stream_id",
        "android_stream_name"
      ],
      "additionalProperties": false
    },
    "volume": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "index",
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "cmd_media_session_volume_get"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "media_session_volume_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "audio_manager_stream_volume_index"
    }
  },
  "required": [
    "device_serial",
    "stream",
    "volume",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-volume-get-result"
}
