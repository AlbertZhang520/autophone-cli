{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "overwrite": {
      "default": false,
      "type": "boolean"
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "output_path",
    "overwrite",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "screenshot-request"
}
