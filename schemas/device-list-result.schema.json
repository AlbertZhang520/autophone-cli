{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "serial": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "online": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "serial",
          "state",
          "online",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "online_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unauthorized_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "offline_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "other_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "state_counts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "default_serial": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "devices",
    "count",
    "online_count",
    "unauthorized_count",
    "offline_count",
    "other_count",
    "state_counts",
    "default_serial"
  ],
  "additionalProperties": false,
  "$id": "device-list-result"
}
