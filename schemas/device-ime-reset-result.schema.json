{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "previous_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+(\\/[A-Za-z0-9_.$]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+(\\/[A-Za-z0-9_.$]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+(\\/[A-Za-z0-9_.$]+)?$"
      }
    },
    "reset": {
      "type": "object",
      "properties": {
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "changed": {
      "type": "boolean"
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "ime_state_readback"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "restores_system_default_enabled_and_selected_imes"
    }
  },
  "required": [
    "device_serial",
    "previous_id",
    "current_id",
    "enabled_ids",
    "reset",
    "changed",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-ime-reset-result"
}
