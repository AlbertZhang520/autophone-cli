{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "condition": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "app"
        },
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "activity": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "package_name"
      ],
      "additionalProperties": false
    },
    "attempts": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "current": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string"
        },
        "activity": {
          "type": "string"
        },
        "focused": {
          "type": "boolean"
        }
      },
      "required": [
        "device_serial",
        "package",
        "activity",
        "focused"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "condition",
    "attempts",
    "elapsed_ms",
    "current"
  ],
  "additionalProperties": false,
  "$id": "wait-app-result"
}
