{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "object",
      "properties": {
        "accessibility_enabled": {
          "type": "object",
          "properties": {
            "raw": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "0",
                    "1"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "raw",
            "value"
          ],
          "additionalProperties": false
        },
        "touch_exploration_enabled": {
          "type": "object",
          "properties": {
            "raw": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "0",
                    "1"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "raw",
            "value"
          ],
          "additionalProperties": false
        },
        "enabled_accessibility_services": {
          "type": "object",
          "properties": {
            "raw": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "services": {
              "maxItems": 128,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*\\/(\\.[A-Za-z_$][A-Za-z0-9_.$]*|[A-Za-z_$][A-Za-z0-9_.$]*)$"
              }
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          },
          "required": [
            "raw",
            "services",
            "count"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "accessibility_enabled",
        "touch_exploration_enabled",
        "enabled_accessibility_services"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "settings_secure_accessibility_enabled",
                  "settings_secure_touch_exploration_enabled",
                  "settings_secure_enabled_accessibility_services"
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command_duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "method",
              "exit_code",
              "command_duration_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "accessibility_secure_settings_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_secure_accessibility_settings_not_runtime_accessibility_node_state"
    }
  },
  "required": [
    "device_serial",
    "settings",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-accessibility-get-result"
}
