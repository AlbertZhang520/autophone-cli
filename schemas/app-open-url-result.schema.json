{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requested": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "path_present": {
          "type": "boolean"
        },
        "query_present": {
          "type": "boolean"
        },
        "fragment_present": {
          "type": "boolean"
        },
        "url_length": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "scheme",
        "hostname",
        "port",
        "path_present",
        "query_present",
        "fragment_present",
        "url_length"
      ],
      "additionalProperties": false
    },
    "before": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string"
        },
        "activity": {
          "type": "string"
        },
        "focused": {
          "type": "boolean"
        }
      },
      "required": [
        "device_serial",
        "package",
        "activity",
        "focused"
      ],
      "additionalProperties": false
    },
    "after": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "device_serial": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": "string"
            },
            "activity": {
              "type": "string"
            },
            "focused": {
              "type": "boolean"
            }
          },
          "required": [
            "device_serial",
            "package",
            "activity",
            "focused"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "open": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "am_start_view"
        },
        "status": {
          "type": "string"
        },
        "activity": {
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "activity_manager_accepted",
            "none"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requested",
    "before",
    "after",
    "open",
    "verify"
  ],
  "additionalProperties": false,
  "$id": "app-open-url-result"
}
