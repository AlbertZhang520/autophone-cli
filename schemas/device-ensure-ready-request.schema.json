{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dismiss_keyguard": {
      "default": true,
      "type": "boolean"
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "dismiss_keyguard",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "device-ensure-ready-request"
}
