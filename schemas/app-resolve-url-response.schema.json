{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "runtime_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "object",
      "properties": {
        "serial": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "device_serial": {
              "type": "string",
              "minLength": 1
            },
            "requested": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "enum": [
                    "http",
                    "https"
                  ]
                },
                "hostname": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path_present": {
                  "type": "boolean"
                },
                "query_present": {
                  "type": "boolean"
                },
                "fragment_present": {
                  "type": "boolean"
                },
                "url_length": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "scheme",
                "hostname",
                "port",
                "path_present",
                "query_present",
                "fragment_present",
                "url_length"
              ],
              "additionalProperties": false
            },
            "resolution": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "none"
                    },
                    "component": {
                      "type": "null"
                    },
                    "package": {
                      "type": "null"
                    },
                    "activity": {
                      "type": "null"
                    },
                    "is_system_resolver": {
                      "type": "boolean",
                      "const": false
                    }
                  },
                  "required": [
                    "type",
                    "component",
                    "package",
                    "activity",
                    "is_system_resolver"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "activity"
                    },
                    "component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "package": {
                      "type": "string",
                      "minLength": 1
                    },
                    "activity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "is_system_resolver": {
                      "type": "boolean",
                      "const": false
                    }
                  },
                  "required": [
                    "type",
                    "component",
                    "package",
                    "activity",
                    "is_system_resolver"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "resolver"
                    },
                    "component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "package": {
                      "type": "string",
                      "minLength": 1
                    },
                    "activity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "is_system_resolver": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "type",
                    "component",
                    "package",
                    "activity",
                    "is_system_resolver"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "metadata": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "priority": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "preferred_order": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "match": {
                      "type": "object",
                      "properties": {
                        "raw": {
                          "type": "string",
                          "pattern": "^0x[0-9a-fA-F]+$"
                        },
                        "value": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "raw",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    "specific_index": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "is_default": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "priority",
                    "preferred_order",
                    "match",
                    "specific_index",
                    "is_default"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "query": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "const": "cmd_package_resolve_activity"
                },
                "exit_code": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "command_duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "method",
                "exit_code",
                "command_duration_ms"
              ],
              "additionalProperties": false
            },
            "verify": {
              "type": "object",
              "properties": {
                "policy": {
                  "type": "string",
                  "const": "package_manager_resolve_activity_parse"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "attempts": {
                  "type": "number",
                  "const": 1
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "policy",
                "ok",
                "attempts",
                "reason"
              ],
              "additionalProperties": false
            },
            "semantics": {
              "type": "string",
              "const": "read_only_url_intent_resolution_not_launchability_or_network_proof"
            }
          },
          "required": [
            "device_serial",
            "requested",
            "resolution",
            "metadata",
            "query",
            "verify",
            "semantics"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "NO_DEVICE",
                "MULTIPLE_DEVICES",
                "DEVICE_OFFLINE",
                "DEVICE_UNAUTHORIZED",
                "DEVICE_NOT_READY",
                "SCREEN_LOCKED",
                "DEVICE_SCREEN_FAILED",
                "DEVICE_NETWORK_FAILED",
                "DEVICE_STORAGE_FAILED",
                "DEVICE_LOCALE_FAILED",
                "DEVICE_BATTERY_FAILED",
                "DEVICE_TIME_FAILED",
                "DEVICE_IME_FAILED",
                "DEVICE_BRIGHTNESS_FAILED",
                "DEVICE_ANIMATIONS_FAILED",
                "DEVICE_ANIMATIONS_SET_FAILED",
                "DEVICE_ACCESSIBILITY_FAILED",
                "DEVICE_ORIENTATION_FAILED",
                "DEVICE_ORIENTATION_SET_FAILED",
                "DEVICE_STATUSBAR_FAILED",
                "DEVICE_VOLUME_FAILED",
                "DEVICE_RINGER_FAILED",
                "DEVICE_NOTIFICATIONS_FAILED",
                "DEVICE_CURRENT_USER_FAILED",
                "DEVICE_USERS_FAILED",
                "DRIVER_UNAVAILABLE",
                "UI_DUMP_FAILED",
                "DUMP_TIMEOUT",
                "TARGET_NOT_FOUND",
                "AMBIGUOUS_TARGET",
                "STALE_SNAPSHOT",
                "UNSAFE_OPERATION",
                "TEXT_ENCODING_UNSUPPORTED",
                "WINDOW_SIZE_UNAVAILABLE",
                "SCROLL_REGION_TOO_SMALL",
                "ACTIVITY_RESOLVE_FAILED",
                "APP_ACTIVITIES_FAILED",
                "APP_LIST_FAILED",
                "APP_CLEAR_DATA_FAILED",
                "APP_INSPECT_FAILED",
                "APP_INSTALL_FAILED",
                "APP_LAUNCH_FAILED",
                "APP_LINKS_FAILED",
                "APP_GRAPHICS_FAILED",
                "APP_MEMORY_FAILED",
                "APP_NOT_RUNNING",
                "APP_PACKAGE_INFO_FAILED",
                "APP_PIDS_FAILED",
                "APP_OPS_FAILED",
                "APP_OPEN_URL_FAILED",
                "APP_RESOLVE_URL_FAILED",
                "APP_PERMISSION_FAILED",
                "APP_PERMISSION_INSPECT_FAILED",
                "APP_STOP_FAILED",
                "APP_UNINSTALL_FAILED",
                "CLIPBOARD_GET_FAILED",
                "CLIPBOARD_SET_FAILED",
                "CLIPBOARD_UNSUPPORTED",
                "FILE_PUSH_FAILED",
                "FILE_PULL_FAILED",
                "FILE_STAT_FAILED",
                "FILE_HASH_FAILED",
                "FILE_RM_FAILED",
                "FILE_LIST_FAILED",
                "FILE_MKDIR_FAILED",
                "FILE_MOVE_FAILED",
                "FILE_COPY_FAILED",
                "ACTION_TIMEOUT",
                "LOGS_UNAVAILABLE",
                "VERIFY_FAILED",
                "WAIT_TIMEOUT",
                "PROOF_DIR_INVALID",
                "PROOF_WRITE_FAILED",
                "RECIPE_INVALID",
                "RECIPE_STEP_FAILED",
                "RECIPE_ABORTED",
                "RECIPE_PREDICATE_FAILED",
                "SCREENSHOT_INVALID",
                "SCREENRECORD_FAILED",
                "OUTPUT_EXISTS",
                "OUTPUT_WRITE_FAILED",
                "ADB_ERROR",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string"
            },
            "retriable": {
              "default": false,
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "retriable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema_version",
    "runtime_version",
    "request_id",
    "ok",
    "command",
    "duration_ms",
    "result",
    "error",
    "warnings",
    "trace"
  ],
  "additionalProperties": false,
  "$id": "app-resolve-url-response"
}
