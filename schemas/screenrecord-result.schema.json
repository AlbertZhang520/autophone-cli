{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "mime_type": {
      "type": "string",
      "const": "video/mp4"
    },
    "file_name": {
      "type": "string",
      "minLength": 1
    },
    "bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "overwritten": {
      "type": "boolean"
    },
    "requested": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "bit_rate_bps": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100000000
            },
            {
              "type": "null"
            }
          ]
        },
        "size": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9]\\d{1,4}x[1-9]\\d{1,4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bugreport": {
          "type": "boolean"
        },
        "display": {
          "type": "string",
          "const": "default"
        }
      },
      "required": [
        "duration_seconds",
        "bit_rate_bps",
        "size",
        "bugreport",
        "display"
      ],
      "additionalProperties": false
    },
    "recording": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "screenrecord"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "transfer": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "adb_pull"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "device_rm"
        },
        "attempted": {
          "type": "boolean",
          "const": true
        },
        "ok": {
          "type": "boolean"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "NO_DEVICE",
            "MULTIPLE_DEVICES",
            "DEVICE_OFFLINE",
            "DEVICE_UNAUTHORIZED",
            "DEVICE_NOT_READY",
            "SCREEN_LOCKED",
            "DEVICE_SCREEN_FAILED",
            "DEVICE_NETWORK_FAILED",
            "DEVICE_STORAGE_FAILED",
            "DEVICE_LOCALE_FAILED",
            "DEVICE_BATTERY_FAILED",
            "DEVICE_TIME_FAILED",
            "DEVICE_IME_FAILED",
            "DEVICE_BRIGHTNESS_FAILED",
            "DEVICE_ANIMATIONS_FAILED",
            "DEVICE_ANIMATIONS_SET_FAILED",
            "DEVICE_ACCESSIBILITY_FAILED",
            "DEVICE_ORIENTATION_FAILED",
            "DEVICE_ORIENTATION_SET_FAILED",
            "DEVICE_STATUSBAR_FAILED",
            "DEVICE_VOLUME_FAILED",
            "DEVICE_RINGER_FAILED",
            "DEVICE_NOTIFICATIONS_FAILED",
            "DEVICE_CURRENT_USER_FAILED",
            "DEVICE_USERS_FAILED",
            "DRIVER_UNAVAILABLE",
            "UI_DUMP_FAILED",
            "DUMP_TIMEOUT",
            "TARGET_NOT_FOUND",
            "AMBIGUOUS_TARGET",
            "STALE_SNAPSHOT",
            "UNSAFE_OPERATION",
            "TEXT_ENCODING_UNSUPPORTED",
            "WINDOW_SIZE_UNAVAILABLE",
            "SCROLL_REGION_TOO_SMALL",
            "ACTIVITY_RESOLVE_FAILED",
            "APP_ACTIVITIES_FAILED",
            "APP_LIST_FAILED",
            "APP_CLEAR_DATA_FAILED",
            "APP_INSPECT_FAILED",
            "APP_INSTALL_FAILED",
            "APP_LAUNCH_FAILED",
            "APP_LINKS_FAILED",
            "APP_GRAPHICS_FAILED",
            "APP_MEMORY_FAILED",
            "APP_NOT_RUNNING",
            "APP_PACKAGE_INFO_FAILED",
            "APP_PIDS_FAILED",
            "APP_OPS_FAILED",
            "APP_OPEN_URL_FAILED",
            "APP_RESOLVE_URL_FAILED",
            "APP_PERMISSION_FAILED",
            "APP_PERMISSION_INSPECT_FAILED",
            "APP_STOP_FAILED",
            "APP_UNINSTALL_FAILED",
            "CLIPBOARD_GET_FAILED",
            "CLIPBOARD_SET_FAILED",
            "CLIPBOARD_UNSUPPORTED",
            "FILE_PUSH_FAILED",
            "FILE_PULL_FAILED",
            "FILE_STAT_FAILED",
            "FILE_HASH_FAILED",
            "FILE_RM_FAILED",
            "FILE_LIST_FAILED",
            "FILE_MKDIR_FAILED",
            "FILE_MOVE_FAILED",
            "FILE_COPY_FAILED",
            "ACTION_TIMEOUT",
            "LOGS_UNAVAILABLE",
            "VERIFY_FAILED",
            "WAIT_TIMEOUT",
            "PROOF_DIR_INVALID",
            "PROOF_WRITE_FAILED",
            "RECIPE_INVALID",
            "RECIPE_STEP_FAILED",
            "RECIPE_ABORTED",
            "RECIPE_PREDICATE_FAILED",
            "SCREENSHOT_INVALID",
            "SCREENRECORD_FAILED",
            "OUTPUT_EXISTS",
            "OUTPUT_WRITE_FAILED",
            "ADB_ERROR",
            "INTERNAL"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "attempted",
        "ok",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "screenrecord_exit_pull_host_file"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 3
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "bounded_default_display_video_evidence_no_audio_or_frame_completeness_guarantee"
    }
  },
  "required": [
    "device_serial",
    "output_path",
    "mime_type",
    "file_name",
    "bytes",
    "sha256",
    "overwritten",
    "requested",
    "recording",
    "transfer",
    "cleanup",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "screenrecord-result"
}
