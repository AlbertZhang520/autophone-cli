{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recipe_version": {
      "type": "string",
      "const": "0.3"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "on_error": {
      "default": "abort",
      "type": "string",
      "enum": [
        "abort",
        "continue"
      ]
    },
    "steps": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "action": {
                "type": "string",
                "const": "find"
              },
              "with": {
                "type": "object",
                "properties": {
                  "selector": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "resource_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "content_desc": {
                        "type": "string",
                        "minLength": 1
                      },
                      "class_name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "timeout_ms": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 120000
                  }
                },
                "required": [
                  "selector",
                  "timeout_ms"
                ],
                "additionalProperties": false
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "abort",
                  "continue"
                ]
              }
            },
            "required": [
              "id",
              "action",
              "with"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "action": {
                "type": "string",
                "const": "wait_ui"
              },
              "with": {
                "type": "object",
                "properties": {
                  "wait_timeout_ms": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 120000
                  },
                  "interval_ms": {
                    "default": 500,
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 10000
                  },
                  "poll_timeout_ms": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 120000
                  },
                  "selector": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "resource_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "content_desc": {
                        "type": "string",
                        "minLength": 1
                      },
                      "class_name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "condition": {
                    "default": "present",
                    "type": "string",
                    "enum": [
                      "present",
                      "absent"
                    ]
                  }
                },
                "required": [
                  "wait_timeout_ms",
                  "interval_ms",
                  "poll_timeout_ms",
                  "selector",
                  "condition"
                ],
                "additionalProperties": false
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "abort",
                  "continue"
                ]
              }
            },
            "required": [
              "id",
              "action",
              "with"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "action": {
                "type": "string",
                "const": "wait_app"
              },
              "with": {
                "type": "object",
                "properties": {
                  "wait_timeout_ms": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 120000
                  },
                  "interval_ms": {
                    "default": 500,
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 10000
                  },
                  "poll_timeout_ms": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 120000
                  },
                  "package_name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
                  },
                  "activity": {
                    "type": "string",
                    "pattern": "^(\\.[A-Za-z_$][A-Za-z0-9_.$]*|[A-Za-z_$][A-Za-z0-9_.$]*)$"
                  }
                },
                "required": [
                  "wait_timeout_ms",
                  "interval_ms",
                  "poll_timeout_ms",
                  "package_name"
                ],
                "additionalProperties": false
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "abort",
                  "continue"
                ]
              }
            },
            "required": [
              "id",
              "action",
              "with"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "action": {
                "type": "string",
                "const": "key_press"
              },
              "with": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "BACK",
                      "HOME",
                      "ENTER",
                      "TAB",
                      "ESCAPE",
                      "DEL",
                      "DPAD_UP",
                      "DPAD_DOWN",
                      "DPAD_LEFT",
                      "DPAD_RIGHT",
                      "DPAD_CENTER",
                      "APP_SWITCH",
                      "MOVE_HOME",
                      "MOVE_END",
                      "MENU",
                      "SEARCH"
                    ]
                  },
                  "verify": {
                    "default": "none",
                    "type": "string",
                    "enum": [
                      "screen_changed",
                      "none"
                    ]
                  },
                  "timeout_ms": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 120000
                  }
                },
                "required": [
                  "key",
                  "verify",
                  "timeout_ms"
                ],
                "additionalProperties": false
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "abort",
                  "continue"
                ]
              }
            },
            "required": [
              "id",
              "action",
              "with"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "action": {
                "type": "string",
                "const": "text_input"
              },
              "with": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[\\x20-\\x24\\x26-\\x5B\\x5D-\\x7E]+$"
                          }
                        ]
                      },
                      "via": {
                        "default": "input_text",
                        "type": "string",
                        "const": "input_text"
                      },
                      "verify": {
                        "default": "none",
                        "type": "string",
                        "enum": [
                          "field_text",
                          "screen_changed",
                          "none"
                        ]
                      },
                      "timeout_ms": {
                        "default": 10000,
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 120000
                      }
                    },
                    "required": [
                      "text",
                      "via",
                      "verify",
                      "timeout_ms"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
                          },
                          {
                            "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
                          }
                        ]
                      },
                      "via": {
                        "type": "string",
                        "const": "adb_keyboard"
                      },
                      "verify": {
                        "default": "none",
                        "type": "string",
                        "enum": [
                          "field_text",
                          "screen_changed",
                          "none"
                        ]
                      },
                      "timeout_ms": {
                        "default": 10000,
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 120000
                      }
                    },
                    "required": [
                      "text",
                      "via",
                      "verify",
                      "timeout_ms"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "allOf": [
                          {
                            "pattern": "\\S"
                          },
                          {
                            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
                          },
                          {
                            "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
                          }
                        ]
                      },
                      "via": {
                        "type": "string",
                        "const": "clipboard"
                      },
                      "verify": {
                        "default": "none",
                        "type": "string",
                        "enum": [
                          "field_text",
                          "screen_changed",
                          "none"
                        ]
                      },
                      "timeout_ms": {
                        "default": 10000,
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 120000
                      }
                    },
                    "required": [
                      "text",
                      "via",
                      "verify",
                      "timeout_ms"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "abort",
                  "continue"
                ]
              }
            },
            "required": [
              "id",
              "action",
              "with"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "action": {
                "type": "string",
                "const": "clipboard_set"
              },
              "with": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "timeout_ms": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 120000
                  }
                },
                "required": [
                  "text",
                  "timeout_ms"
                ],
                "additionalProperties": false
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "abort",
                  "continue"
                ]
              }
            },
            "required": [
              "id",
              "action",
              "with"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "action": {
                "type": "string",
                "const": "clipboard_get"
              },
              "with": {
                "type": "object",
                "properties": {
                  "timeout_ms": {
                    "default": 10000,
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 120000
                  }
                },
                "required": [
                  "timeout_ms"
                ],
                "additionalProperties": false
              },
              "on_error": {
                "type": "string",
                "enum": [
                  "abort",
                  "continue"
                ]
              }
            },
            "required": [
              "id",
              "action",
              "with"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "recipe_version",
    "name",
    "on_error",
    "steps"
  ],
  "additionalProperties": false,
  "$id": "recipe-file"
}
