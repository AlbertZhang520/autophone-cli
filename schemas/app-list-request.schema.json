{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "third_party",
        "system"
      ]
    },
    "state": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "enabled",
        "disabled"
      ]
    },
    "include_uninstalled": {
      "default": false,
      "type": "boolean"
    },
    "filter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._]+$"
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "scope",
    "state",
    "include_uninstalled",
    "timeout_ms"
  ],
  "additionalProperties": false,
  "$id": "app-list-request"
}
