{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "output_path": {
      "type": "string",
      "minLength": 1
    },
    "mime_type": {
      "type": "string",
      "const": "image/png"
    },
    "width_px": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height_px": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capture_duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "overwritten": {
      "type": "boolean"
    }
  },
  "required": [
    "device_serial",
    "output_path",
    "mime_type",
    "width_px",
    "height_px",
    "bytes",
    "sha256",
    "capture_duration_ms",
    "overwritten"
  ],
  "additionalProperties": false,
  "$id": "screenshot-result"
}
