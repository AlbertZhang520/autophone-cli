{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
        },
        "op_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "user_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "package_name",
        "op_name",
        "user_id"
      ],
      "additionalProperties": false
    },
    "lookup": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "no_uid"
          ]
        },
        "uid_resolved": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "enum": [
            "appops_uid_resolved",
            "no_appops_uid_for_package_in_queried_user"
          ]
        }
      },
      "required": [
        "status",
        "uid_resolved",
        "reason"
      ],
      "additionalProperties": false
    },
    "default_mode": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "raw": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\s;:\\u0000-\\u001f\\u007f]+$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "allow",
                "ignore",
                "deny",
                "default",
                "foreground",
                "ask",
                "unknown"
              ]
            }
          },
          "required": [
            "raw",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "uid",
              "package"
            ]
          },
          "op_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "mode": {
            "type": "object",
            "properties": {
              "raw": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\s;:\\u0000-\\u001f\\u007f]+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "allow",
                  "ignore",
                  "deny",
                  "default",
                  "foreground",
                  "ask",
                  "unknown"
                ]
              }
            },
            "required": [
              "raw",
              "kind"
            ],
            "additionalProperties": false
          },
          "details": {
            "type": "object",
            "properties": {
              "time_raw": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reject_time_raw": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_raw": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "time_raw",
              "reject_time_raw",
              "duration_raw"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "scope",
          "op_name",
          "mode",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "cmd_appops_get"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "cmd_appops_get_single_op_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_appops_single_op_snapshot_not_runtime_permission_or_effective_behavior_proof"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "lookup",
    "default_mode",
    "entries",
    "entry_count",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "app-ops-get-result"
}
