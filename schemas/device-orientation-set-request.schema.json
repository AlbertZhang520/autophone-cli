{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "lock"
      ]
    },
    "rotation_degrees": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 90
        },
        {
          "type": "number",
          "const": 180
        },
        {
          "type": "number",
          "const": 270
        }
      ]
    },
    "timeout_ms": {
      "default": 10000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120000
    },
    "device_serial": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "mode",
    "timeout_ms",
    "device_serial"
  ],
  "additionalProperties": false,
  "$id": "device-orientation-set-request"
}
