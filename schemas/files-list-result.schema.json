{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "remote_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "max_entries": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 500
        }
      },
      "required": [
        "remote_path",
        "max_entries"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "entry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "regular_file",
                    "directory",
                    "symlink",
                    "other"
                  ]
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modified_unix_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "bytes",
                "modified_unix_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "device_stat"
            },
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "command_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "method",
            "exit_code",
            "command_duration_ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "exists",
        "entry",
        "query"
      ],
      "additionalProperties": false
    },
    "list": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "device_find_stat"
            },
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "command_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "regular_file",
                      "directory",
                      "symlink",
                      "other"
                    ]
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "modified_unix_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "name",
                  "path",
                  "kind",
                  "bytes",
                  "modified_unix_ms"
                ],
                "additionalProperties": false
              }
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "method",
            "exit_code",
            "command_duration_ms",
            "entries",
            "count",
            "truncated"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "bounded_single_directory_listing"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_single_directory_listing_not_recursive"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "target",
    "list",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "files-list-result"
}
