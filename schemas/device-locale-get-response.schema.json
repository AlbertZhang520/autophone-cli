                "DEVICE_LOCALE_FAILED",
                "DEVICE_BATTERY_FAILED",
                "DEVICE_TIME_FAILED",
                "DEVICE_IME_FAILED",
                "DEVICE_BRIGHTNESS_FAILED",
                "DEVICE_ANIMATIONS_FAILED",
                "DEVICE_ANIMATIONS_SET_FAILED",
                "DEVICE_ACCESSIBILITY_FAILED",
                "DEVICE_ORIENTATION_FAILED",
                "DEVICE_ORIENTATION_SET_FAILED",
                "DEVICE_STATUSBAR_FAILED",
                "DEVICE_VOLUME_FAILED",
                "DEVICE_RINGER_FAILED",
                "DEVICE_NOTIFICATIONS_FAILED",
                "DEVICE_CURRENT_USER_FAILED",
                "DEVICE_USERS_FAILED",
                "DRIVER_UNAVAILABLE",
                "UI_DUMP_FAILED",
                "DUMP_TIMEOUT",
                "TARGET_NOT_FOUND",
                "AMBIGUOUS_TARGET",
                "STALE_SNAPSHOT",
                "UNSAFE_OPERATION",
                "TEXT_ENCODING_UNSUPPORTED",
                "WINDOW_SIZE_UNAVAILABLE",
                "SCROLL_REGION_TOO_SMALL",
                "ACTIVITY_RESOLVE_FAILED",
                "APP_ACTIVITIES_FAILED",
                "APP_LIST_FAILED",
                "APP_CLEAR_DATA_FAILED",
                "APP_INSPECT_FAILED",
                "APP_INSTALL_FAILED",
                "APP_LAUNCH_FAILED",
                "APP_LINKS_FAILED",
                "APP_GRAPHICS_FAILED",
                "APP_MEMORY_FAILED",
                "APP_NOT_RUNNING",
                "APP_PACKAGE_INFO_FAILED",
                "APP_PIDS_FAILED",
                "APP_OPS_FAILED",
                "APP_OPEN_URL_FAILED",
                "APP_RESOLVE_URL_FAILED",
                "APP_PERMISSION_FAILED",
                "APP_PERMISSION_INSPECT_FAILED",
                "APP_STOP_FAILED",
                "APP_UNINSTALL_FAILED",
                "CLIPBOARD_GET_FAILED",
                "CLIPBOARD_SET_FAILED",
                "CLIPBOARD_UNSUPPORTED",
                "FILE_PUSH_FAILED",
                "FILE_PULL_FAILED",
                "FILE_STAT_FAILED",
                "FILE_HASH_FAILED",
                "FILE_RM_FAILED",
                "FILE_LIST_FAILED",
                "FILE_MKDIR_FAILED",
                "FILE_MOVE_FAILED",
                "FILE_COPY_FAILED",
                "ACTION_TIMEOUT",
                "LOGS_UNAVAILABLE",
                "VERIFY_FAILED",
                "WAIT_TIMEOUT",
                "PROOF_DIR_INVALID",
                "PROOF_WRITE_FAILED",
                "RECIPE_INVALID",
                "RECIPE_STEP_FAILED",
                "RECIPE_ABORTED",
                "RECIPE_PREDICATE_FAILED",
                "SCREENSHOT_INVALID",
                "SCREENRECORD_FAILED",
                "OUTPUT_EXISTS",
                "OUTPUT_WRITE_FAILED",
                "ADB_ERROR",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string"
            },
            "retriable": {
              "default": false,
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "retriable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema_version",
    "runtime_version",
    "request_id",
    "ok",
    "command",
    "duration_ms",
    "result",
    "error",
    "warnings",
    "trace"
  ],
  "additionalProperties": false,
  "$id": "device-locale-get-response"
}
