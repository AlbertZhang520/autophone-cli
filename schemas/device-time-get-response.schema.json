{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "runtime_version": {
      "type": "string",
      "const": "0.3.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "device": {
      "type": "object",
      "properties": {
        "serial": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "device_serial": {
              "type": "string",
              "minLength": 1
            },
            "time": {
              "type": "object",
              "properties": {
                "unix_epoch_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "timezone_offset": {
                  "type": "string",
                  "pattern": "^[+-]\\d{2}:\\d{2}$"
                },
                "timezone_offset_minutes": {
                  "type": "integer",
                  "minimum": -1439,
                  "maximum": 1439
                }
              },
              "required": [
                "unix_epoch_seconds",
                "timezone_offset",
                "timezone_offset_minutes"
              ],
              "additionalProperties": false
            },
            "settings": {
              "type": "object",
              "properties": {
                "auto_time": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "auto_time_zone": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "auto_time",
                "auto_time_zone"
              ],
              "additionalProperties": false
            },
            "timezone": {
              "type": "object",
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "settings_global_time_zone",
                        "persist_sys_timezone"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sources": {
                  "type": "object",
                  "properties": {
                    "settings_global_time_zone": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "persist_sys_timezone": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "settings_global_time_zone",
                    "persist_sys_timezone"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "source",
                "sources"
              ],
              "additionalProperties": false
            },
            "query": {
              "type": "object",
              "properties": {
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "method": {
                        "type": "string",
                        "enum": [
                          "date_unix_epoch_offset",
                          "settings_global_auto_time",
                          "settings_global_auto_time_zone",
                          "settings_global_time_zone",
                          "getprop_persist_sys_timezone"
                        ]
                      },
                      "exit_code": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "command_duration_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "method",
                      "exit_code",
                      "command_duration_ms"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "sources"
              ],
              "additionalProperties": false
            },
            "verify": {
              "type": "object",
              "properties": {
                "policy": {
                  "type": "string",
                  "const": "device_time_sources_parse"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "attempts": {
                  "type": "number",
                  "const": 1
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "policy",
                "ok",
                "attempts",
                "reason"
              ],
              "additionalProperties": false
            },
            "semantics": {
              "type": "string",
              "const": "read_only_device_time_snapshot_not_ntp_or_scheduler_guarantee"
            }
          },
          "required": [
            "device_serial",
            "time",
            "settings",
            "timezone",
            "query",
            "verify",
            "semantics"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_REQUEST",
                "NO_DEVICE",
                "MULTIPLE_DEVICES",
                "DEVICE_OFFLINE",
                "DEVICE_UNAUTHORIZED",
                "DEVICE_NOT_READY",
                "SCREEN_LOCKED",
                "DEVICE_SCREEN_FAILED",
                "DEVICE_NETWORK_FAILED",
                "DEVICE_STORAGE_FAILED",
                "DEVICE_LOCALE_FAILED",
                "DEVICE_BATTERY_FAILED",
                "DEVICE_TIME_FAILED",
                "DEVICE_IME_FAILED",
                "DEVICE_BRIGHTNESS_FAILED",
                "DEVICE_ANIMATIONS_FAILED",
                "DEVICE_ANIMATIONS_SET_FAILED",
                "DEVICE_ACCESSIBILITY_FAILED",
                "DEVICE_ORIENTATION_FAILED",
                "DEVICE_ORIENTATION_SET_FAILED",
                "DEVICE_STATUSBAR_FAILED",
                "DEVICE_VOLUME_FAILED",
                "DEVICE_RINGER_FAILED",
                "DEVICE_NOTIFICATIONS_FAILED",
                "DEVICE_CURRENT_USER_FAILED",
                "DEVICE_USERS_FAILED",
                "DRIVER_UNAVAILABLE",
                "UI_DUMP_FAILED",
                "DUMP_TIMEOUT",
                "TARGET_NOT_FOUND",
                "AMBIGUOUS_TARGET",
                "STALE_SNAPSHOT",
                "UNSAFE_OPERATION",
                "TEXT_ENCODING_UNSUPPORTED",
                "WINDOW_SIZE_UNAVAILABLE",
                "SCROLL_REGION_TOO_SMALL",
                "ACTIVITY_RESOLVE_FAILED",
                "APP_ACTIVITIES_FAILED",
                "APP_LIST_FAILED",
                "APP_CLEAR_DATA_FAILED",
                "APP_INSPECT_FAILED",
                "APP_INSTALL_FAILED",
                "APP_LAUNCH_FAILED",
                "APP_LINKS_FAILED",
                "APP_GRAPHICS_FAILED",
                "APP_MEMORY_FAILED",
                "APP_NOT_RUNNING",
                "APP_PACKAGE_INFO_FAILED",
                "APP_PIDS_FAILED",
                "APP_OPS_FAILED",
                "APP_OPEN_URL_FAILED",
                "APP_RESOLVE_URL_FAILED",
                "APP_PERMISSION_FAILED",
                "APP_PERMISSION_INSPECT_FAILED",
                "APP_STOP_FAILED",
                "APP_UNINSTALL_FAILED",
                "CLIPBOARD_GET_FAILED",
                "CLIPBOARD_SET_FAILED",
                "CLIPBOARD_UNSUPPORTED",
                "FILE_PUSH_FAILED",
                "FILE_PULL_FAILED",
                "FILE_STAT_FAILED",
                "FILE_HASH_FAILED",
                "FILE_RM_FAILED",
                "FILE_LIST_FAILED",
                "FILE_MKDIR_FAILED",
                "FILE_MOVE_FAILED",
                "FILE_COPY_FAILED",
                "ACTION_TIMEOUT",
                "LOGS_UNAVAILABLE",
                "VERIFY_FAILED",
                "WAIT_TIMEOUT",
                "PROOF_DIR_INVALID",
                "PROOF_WRITE_FAILED",
                "RECIPE_INVALID",
                "RECIPE_STEP_FAILED",
                "RECIPE_ABORTED",
                "RECIPE_PREDICATE_FAILED",
                "SCREENSHOT_INVALID",
                "SCREENRECORD_FAILED",
                "OUTPUT_EXISTS",
                "OUTPUT_WRITE_FAILED",
                "ADB_ERROR",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string"
            },
            "retriable": {
              "default": false,
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "retriable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schema_version",
    "runtime_version",
    "request_id",
    "ok",
    "command",
    "duration_ms",
    "result",
    "error",
    "warnings",
    "trace"
  ],
  "additionalProperties": false,
  "$id": "device-time-get-response"
}
