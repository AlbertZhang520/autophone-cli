{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        }
      },
      "required": [
        "package_name"
      ],
      "additionalProperties": false
    },
    "running": {
      "type": "boolean"
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "process_name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "pid",
          "process_name"
        ],
        "additionalProperties": false
      }
    },
    "process_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "graphics": {
      "type": "object",
      "properties": {
        "stats_since_ns": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_frames_rendered": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "janky_frames": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "count",
                "percent"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "janky_frames_legacy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "count",
                "percent"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "percentiles_ms": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "p50_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "p90_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "p95_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "p99_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "p50_ms",
                "p90_ms",
                "p95_ms",
                "p99_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "slow_counts": {
          "type": "object",
          "properties": {
            "missed_vsync": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "high_input_latency": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "slow_ui_thread": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "slow_bitmap_uploads": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "slow_issue_draw_commands": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "missed_vsync",
            "high_input_latency",
            "slow_ui_thread",
            "slow_bitmap_uploads",
            "slow_issue_draw_commands"
          ],
          "additionalProperties": false
        },
        "frame_deadline_missed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "frame_deadline_missed_legacy": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "histogram": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "buckets": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "bucket_ms": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "bucket_ms",
                      "count"
                    ],
                    "additionalProperties": false
                  }
                },
                "bucket_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "buckets",
                "bucket_count",
                "truncated"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "percentiles_ms": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "p50_ms": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "p90_ms": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "p95_ms": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "p99_ms": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "p50_ms",
                        "p90_ms",
                        "p95_ms",
                        "p99_ms"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "histogram": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "buckets": {
                          "maxItems": 256,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "bucket_ms": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              "count": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "bucket_ms",
                              "count"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "bucket_count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "truncated": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "buckets",
                        "bucket_count",
                        "truncated"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "percentiles_ms",
                "histogram"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stats_since_ns",
        "total_frames_rendered",
        "janky_frames",
        "janky_frames_legacy",
        "percentiles_ms",
        "slow_counts",
        "frame_deadline_missed",
        "frame_deadline_missed_legacy",
        "histogram",
        "gpu"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "dumpsys_gfxinfo"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "dumpsys_gfxinfo_frame_summary_snapshot"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_graphics_summary_since_last_reset_not_sustained_performance_guarantee"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "running",
    "processes",
    "process_count",
    "graphics",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "app-graphics-result"
}
