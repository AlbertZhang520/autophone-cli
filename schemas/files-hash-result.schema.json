{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "requested": {
      "type": "object",
      "properties": {
        "remote_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "md5"
          ]
        }
      },
      "required": [
        "remote_path",
        "algorithm"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "entry": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "regular_file",
                    "directory",
                    "symlink",
                    "other"
                  ]
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modified_unix_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "kind",
                "bytes",
                "modified_unix_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "device_stat"
            },
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "command_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "method",
            "exit_code",
            "command_duration_ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "exists",
        "entry",
        "query"
      ],
      "additionalProperties": false
    },
    "hash": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "const": "sha256"
                },
                "method": {
                  "type": "string",
                  "const": "device_sha256sum"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "exit_code": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "command_duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "algorithm",
                "method",
                "digest",
                "exit_code",
                "command_duration_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "const": "md5"
                },
                "method": {
                  "type": "string",
                  "const": "device_md5sum"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^md5:[a-f0-9]{32}$"
                },
                "exit_code": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "command_duration_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "algorithm",
                "method",
                "digest",
                "exit_code",
                "command_duration_ms"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "hashed": {
      "type": "boolean"
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "regular_file_stat_then_digest_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_single_regular_file_content_digest_not_atomic"
    }
  },
  "required": [
    "device_serial",
    "requested",
    "target",
    "hash",
    "hashed",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "files-hash-result"
}
