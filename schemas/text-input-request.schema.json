          "allOf": [
            {
              "pattern": "\\S"
            },
            {
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*$"
            },
            {
              "pattern": "^(?:[^\\uD800-\\uDFFF]|[\\uD800-\\uDBFF][\\uDC00-\\uDFFF])*$"
            }
          ]
        },
        "via": {
          "type": "string",
