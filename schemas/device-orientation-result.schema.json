{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "window_size": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "orientation": {
      "type": "string",
      "enum": [
        "portrait",
        "landscape",
        "unknown"
      ]
    },
    "rotation_degrees": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 90
            },
            {
              "type": "number",
              "const": 180
            },
            {
              "type": "number",
              "const": 270
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "auto_rotate": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "query": {
      "type": "object",
      "properties": {
        "window_size": {
          "type": "object",
          "properties": {
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "command_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "method": {
              "type": "string",
              "const": "wm_size"
            }
          },
          "required": [
            "exit_code",
            "command_duration_ms",
            "method"
          ],
          "additionalProperties": false
        },
        "rotation": {
          "type": "object",
          "properties": {
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "command_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "method": {
              "type": "string",
              "const": "dumpsys_window"
            }
          },
          "required": [
            "exit_code",
            "command_duration_ms",
            "method"
          ],
          "additionalProperties": false
        },
        "auto_rotate": {
          "type": "object",
          "properties": {
            "exit_code": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "command_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "method": {
              "type": "string",
              "const": "settings_get_accelerometer_rotation"
            }
          },
          "required": [
            "exit_code",
            "command_duration_ms",
            "method"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "window_size",
        "rotation",
        "auto_rotate"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "actual_display_rotation_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "actual_display_rotation_without_ui_dump"
    }
  },
  "required": [
    "device_serial",
    "window_size",
    "orientation",
    "rotation_degrees",
    "auto_rotate",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-orientation-result"
}
