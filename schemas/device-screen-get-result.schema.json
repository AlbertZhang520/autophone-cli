{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "minLength": 1
        },
        "awake": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "interactive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "wakefulness": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "display_power_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "keyguard_showing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "keyguard_secure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_serial",
        "awake",
        "interactive",
        "wakefulness",
        "display_power_state",
        "keyguard_showing",
        "keyguard_secure"
      ],
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "properties": {
        "display_power": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "doze",
            "unknown"
          ]
        },
        "screen_unlocked": {
          "type": "boolean"
        }
      },
      "required": [
        "display_power",
        "screen_unlocked"
      ],
      "additionalProperties": false
    },
    "keyguard": {
      "type": "object",
      "properties": {
        "showing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "secure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "showing",
        "secure"
      ],
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "dumpsys_power",
                  "dumpsys_window"
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command_duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "method",
              "exit_code",
              "command_duration_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "const": "screen_keyguard_state_parse"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "attempts": {
          "type": "number",
          "const": 1
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "policy",
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    },
    "semantics": {
      "type": "string",
      "const": "read_only_screen_keyguard_probe_not_readiness_mutation"
    }
  },
  "required": [
    "device_serial",
    "state",
    "screen",
    "keyguard",
    "query",
    "verify",
    "semantics"
  ],
  "additionalProperties": false,
  "$id": "device-screen-get-result"
}
