{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "device_serial": {
      "type": "string",
      "minLength": 1
    },
    "before": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "minLength": 1
        },
        "awake": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "interactive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "wakefulness": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "display_power_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "keyguard_showing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "keyguard_secure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_serial",
        "awake",
        "interactive",
        "wakefulness",
        "display_power_state",
        "keyguard_showing",
        "keyguard_secure"
      ],
      "additionalProperties": false
    },
    "after": {
      "type": "object",
      "properties": {
        "device_serial": {
          "type": "string",
          "minLength": 1
        },
        "awake": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "interactive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "wakefulness": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "display_power_state": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "keyguard_showing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "keyguard_secure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device_serial",
        "awake",
        "interactive",
        "wakefulness",
        "display_power_state",
        "keyguard_showing",
        "keyguard_secure"
      ],
      "additionalProperties": false
    },
    "wake": {
      "type": "object",
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "keycode": {
          "type": "string",
          "const": "KEYCODE_WAKEUP"
        },
        "command_duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attempted",
        "keycode",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "dismiss_keyguard": {
      "type": "object",
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "const": "wm_dismiss_keyguard"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "command_duration_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "attempted",
        "method",
        "exit_code",
        "command_duration_ms"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "attempts",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "device_serial",
    "before",
    "after",
    "wake",
    "dismiss_keyguard",
    "verify"
  ],
  "additionalProperties": false,
  "$id": "device-ensure-ready-result"
}
